{
  "expo": {
    "name": "FinanceApp",
    "slug": "finance-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "financeapp",
    "icon": "./assets/images/icon.png",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/0111cb26-b0be-4302-b636-7b01b50a37cc"
    },
    "android": {
      "package": "com.financeapp.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#171A16",
        "monochromeImage": "./assets/images/monochrome-icon.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Gunakan Face ID untuk membuka kunci FinanceApp."
        }
      ],
      "expo-splash-screen",
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan FinanceApp mengakses galeri untuk memilih foto profil.",
          "cameraPermission": "Izinkan FinanceApp menggunakan kamera untuk mengambil foto profil.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE_WITH_IOS_CLIENT_ID"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0111cb26-b0be-4302-b636-7b01b50a37cc"
      }
    },
    "owner": "hans2awesome"
  }
}
